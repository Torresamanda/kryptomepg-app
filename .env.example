# Firebase web configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Set this to the complete, single-line JSON of a Firebase service account.
# Never prefix this variable with NEXT_PUBLIC and never commit a real value.
FIREBASE_SERVICE_ACCOUNT_KEY=
